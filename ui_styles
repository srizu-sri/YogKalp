class StyleSheet:
    @staticmethod
    def get_font(size=12, weight="Regular"):
        """Get a font with the specified size and weight"""
        weights = {
            "Regular": QFont.Weight.Normal,
            "Medium": QFont.Weight.Medium,
            "SemiBold": QFont.Weight.DemiBold,
            "Bold": QFont.Weight.Bold
        }
        font = QFont("Inter", size)
        font.setWeight(weights.get(weight, QFont.Weight.Normal))
        return font
    
    @staticmethod
    def card():
        """Style for a card component"""
        return """
            background-color: white;
            border-radius: 16px;
            border: none;
        """
    
    @staticmethod
    def card_shadow():
        """Shadow effect for cards"""
        shadow = QtWidgets.QGraphicsDropShadowEffect()
        shadow.setBlurRadius(15)
        shadow.setColor(QColor(0, 0, 0, 20))
        shadow.setOffset(0, 2)
        return shadow
    
    @staticmethod
    def button_primary():
        """Style for primary buttons"""
        return """
            QPushButton {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2196F3, stop:1 #9C27B0);
                color: white;
                border-radius: 12px;
                padding: 12px 24px;
                font-weight: 500;
            }
            QPushButton:hover {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1E88E5, stop:1 #8E24AA);
            }
            QPushButton:pressed {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1976D2, stop:1 #7B1FA2);
            }
        """
    
    @staticmethod
    def button_secondary():
        """Style for secondary buttons"""
        return """
            QPushButton {
                background-color: #F1F3F4;
                color: #3C4043;
                border-radius: 12px;
                padding: 12px 24px;
                font-weight: 500;
            }
            QPushButton:hover {
                background-color: #E8EAED;
            }
            QPushButton:pressed {
                background-color: #DADCE0;
            }
        """
    
    @staticmethod
    def input_field():
        """Style for input fields"""
        return """
            QLineEdit, QTextEdit, QComboBox {
                background-color: white;
                border: 1px solid #DADCE0;
                border-radius: 12px;
                padding: 12px 16px;
                color: #202124;
            }
            QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
                border: 2px solid #2196F3;
            }
            QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled {
                background-color: #F1F3F4;
                color: #9AA0A6;
            }
        """
    
    @staticmethod
    def metric_card():
        """Style for metric cards"""
        return """
            QFrame {
                background-color: white;
                border-radius: 16px;
                border: 1px solid #E8EAED;
                padding: 16px;
            }
            QFrame:hover {
                border: 1px solid #DADCE0;
            }
        """
    
    @staticmethod
    def gradient_card():
        """Style for gradient background cards"""
        return """
            QFrame {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2196F3, stop:1 #9C27B0);
                color: white;
                border-radius: 16px;
                padding: 16px;
            }
        """
    
    @staticmethod
    def header_text():
        """Style for header text"""
        return "color: #202124; font-weight: bold;"
    
    @staticmethod
    def subheader_text():
        """Style for subheader text"""
        return "color: #3C4043; font-weight: 500;"
    
    @staticmethod
    def body_text():
        """Style for body text"""
        return "color: #5F6368;"
    
    @staticmethod
    def accent_text(color="blue"):
        """Style for accent text"""
        colors = {
            "blue": "#1976D2",
            "purple": "#7B1FA2",
            "green": "#388E3C",
            "red": "#D32F2F",
            "orange": "#F57C00",
            "yellow": "#FFA000"
        }
        return f"color: {colors.get(color, '#1976D2')}; font-weight: 500;"
    
    @staticmethod
    def text_gradient():
        """Style for gradient text"""
        return """
            background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8B5CF6, stop:1 #3B82F6);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            font-weight: 500;
        """
